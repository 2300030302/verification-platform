# Production Environment Variables Template
# Server Port (Default: 3001)
PORT=3001
NODE_ENV=production

# Managed Cloud MySQL Database Configuration
# (e.g. PlanetScale, Aiven, Supabase, TiDB Cloud, AWS RDS)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=verification_platform
# Set DB_SSL=true if your cloud MySQL provider requires SSL/TLS
DB_SSL=true

# JWT Authentication Secret
# Must be a strong, unpredictable random string (32+ chars) in production
JWT_SECRET=replace_with_a_long_random_production_jwt_secret

# Production Frontend URL for CORS (e.g. https://your-deployment.vercel.app)
FRONTEND_URL=https://your-deployment.vercel.app

# Vercel Blob Token (Optional: Required for persistent document storage in Vercel Serverless Functions)
# Auto-populated if linked to Vercel Blob store in project settings
BLOB_READ_WRITE_TOKEN=

# AI Assistant & Officer Copilot API Keys (Optional: Falls back to grounded rule engine if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
