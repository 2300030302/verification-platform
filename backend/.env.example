# Server Port (Default: 3001)
PORT=3001
NODE_ENV=production

# MySQL Database Configuration
# In production on Vercel, use a managed cloud MySQL instance (e.g. PlanetScale, Aiven, Supabase, AWS RDS)
DB_HOST=your-mysql-host.example.com
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=verification_platform
DB_PORT=3306
# Set DB_SSL=true if your cloud MySQL provider requires SSL/TLS (e.g. Aiven, PlanetScale)
DB_SSL=false

# JWT Authentication Secret
# Must be a strong, unpredictable random string in production
JWT_SECRET=replace_with_a_long_random_production_jwt_secret

# Production Frontend URL for CORS (e.g. https://your-frontend.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Vercel Blob Token (Optional: Required for persistent document storage in Vercel Serverless Functions)
# Obtained from Vercel Project Settings > Storage > Blob
BLOB_READ_WRITE_TOKEN=
